# Required. Postgres connection string for the shared Supabase project
# (Project Settings -> Database -> Connection string -> "Transaction pooler"
# is recommended for serverless/Vercel; a direct connection works too for
# local dev). The app's tables live in the `money_mountain` schema there —
# see lib/db/schema.ts. Tests use the isolated `money_mountain_test` schema
# in the same database automatically (see vitest.setup.ts).
DATABASE_URL=

# Optional — without this, the app runs entirely on mock/fixture data
# (fully demoable, no external calls). Set a real key to draft live via
# the Anthropic API (web search + structured output).
ANTHROPIC_API_KEY=

# Optional — model used for live drafting calls. Defaults to claude-opus-5.
MONEY_MOUNTAIN_MODEL=
